{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AMC sample metadata",
  "description": "Schema for AMC split metadata.",
  "type": "object",
  "required": [
    "clip_id",
    "duration_sec",
    "genre",
    "emotion_label",
    "tempo_range",
    "text_prompt",
    "split",
    "raw_media_available"
  ],
  "properties": {
    "clip_id": {
      "type": "string",
      "description": "Anonymized clip identifier"
    },
    "duration_sec": {
      "type": "number",
      "description": "Clip duration in seconds",
      "default": 10
    },
    "genre": {
      "type": "string",
      "description": "Music genre label"
    },
    "emotion_label": {
      "type": "string",
      "enum": [
        "very positive",
        "moderate positive",
        "neutral",
        "moderate negative",
        "very negative"
      ]
    },
    "tempo_range": {
      "type": "string",
      "description": "Target BPM range"
    },
    "text_prompt": {
      "type": "string",
      "description": "Conditioning text prompt"
    },
    "split": {
      "type": "string",
      "enum": ["train", "validation", "test", "created_controls"]
    },
    "raw_media_available": {
      "type": "boolean",
      "description": "Whether the raw media file can be redistributed"
    }
  }
}
